# Copia questo file in .env.local (sviluppo) o .env (produzione) e completa i valori.
# Nessuna variabile è obbligatoria per provare l'app in locale.

# --- Stagione ---
SEASON_CODE=2026-27

# --- Accesso ---
# Codice richiesto per creare il PRIMO account (consigliato se l'app è raggiungibile da Internet).
SETUP_TOKEN=
# Codice invito da dare agli amici per registrarsi (vuoto = registrazioni chiuse).
INVITE_CODE=
# true = registrazione libera senza codice (sconsigliato su Internet).
ALLOW_REGISTRATION=false
# Solo per test in HTTP su rete locale: permette i cookie di sessione senza HTTPS in produzione.
# (scripts/avvia.mjs lo attiva da solo quando l'app gira sul tuo computer.)
INSECURE_COOKIES=false
# Domini aggiuntivi da cui accettare i moduli, se un proxy inoltra un host diverso (separati da virgola).
SERVER_ACTIONS_ALLOWED_ORIGINS=

# --- Database (SQLite) ---
DATABASE_PATH=./data/fantacalcio.sqlite
DEMO_DATABASE_PATH=./data/demo.sqlite

# --- Fonti dati ---
# Le chiavi si possono anche incollare nell'app (pagina Fonti, solo l'amministratore): la variabile qui ha la precedenza.
# football-data.org: chiave gratuita (registrazione) -> calendario, risultati, rose ufficiali, marcatori.
FOOTBALL_DATA_API_KEY=
# API-Football (api-sports.io): infortuni, formazioni ufficiali, statistiche individuali. Verifica la copertura del piano con il test in "Fonti".
API_FOOTBALL_KEY=
# Massimo di richieste per statistiche giocatore a ogni aggiornamento (il piano gratuito ha 100 richieste/giorno).
API_FOOTBALL_MAX_PLAYER_CALLS=25
# TheSportsDB: senza valore usa la chiave pubblica gratuita "123".
THESPORTSDB_API_KEY=
# Feed RSS aggiuntivi: "Nome|https://url-del-feed;Altro|https://..."
EXTRA_RSS_FEEDS=
DISABLE_SOSFANTA_RSS=false

# --- Aggiornamenti automatici ---
# Scheduler interno (processo sempre attivo): controlla ogni N minuti se serve aggiornare.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5
# Per piattaforme senza processi sempre attivi: chiama GET /api/cron con "Authorization: Bearer <CRON_SECRET>" ogni 10-15 minuti.
CRON_SECRET=
